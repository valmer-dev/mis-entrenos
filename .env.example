# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Copia este fichero a `.env.local` y rellena los dos valores.
# Los encontrarás en: Supabase → tu proyecto → Project Settings → API
#
# Ambas variables son públicas por diseño (llegan al navegador). Lo que protege
# los datos son las políticas RLS definidas en supabase/migrations/0001_init.sql.
#
# NUNCA pongas aquí la `service_role` key: tiene permisos totales y se salta RLS.

# URL del proyecto, con el formato https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública del proyecto ("anon public" / "publishable key")
NEXT_PUBLIC_SUPABASE_ANON_KEY=
